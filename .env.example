# Copy to .env and fill in. .env is gitignored.

# --- Django ---
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL (Laragon defaults) ---
DB_NAME=ai_shorts
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Provider API keys (leave blank until you add billing) ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Models ---
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Cost guardrail ---
MAX_COST_PER_VIDEO_USD=25

# --- Long-form generation tuning ---
WORDS_PER_MINUTE=150
DEFAULT_TARGET_MINUTES=90
TARGET_MINUTES_PER_PART=6
IMAGES_PER_PART=4
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

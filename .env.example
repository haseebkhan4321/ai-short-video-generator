# Copy to .env and fill in. .env is gitignored.

# --- Django ---
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Development quick sign-in ---
# One-click sign-in as a seeded user, no password, shown on the sign-in page.
# Only ever active when DEBUG is also True, and only for users at
# DEV_LOGIN_EMAIL_DOMAIN — so it cannot sign you in as a real account.
# Leave it False unless you are working locally.
DEV_LOGIN_ENABLED=False
DEV_LOGIN_EMAIL_DOMAIN=dev.local

# --- Sessions / auth ---
# Every page requires a login, so a session cookie is worth protecting.
# Two weeks by default; set SESSION_EXPIRE_AT_BROWSER_CLOSE=True to end on close.
SESSION_COOKIE_AGE=1209600
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
# Set both to True when serving over HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- MySQL (Laragon defaults) ---
DB_NAME=ai_shorts
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Provider API keys (leave blank until you add billing) ---
OPENAI_API_KEY=

# --- Models ---
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Text-to-speech (narration): Kokoro, local and free ---
TTS_PROVIDER=kokoro
DEFAULT_KOKORO_VOICE=af_heart
# Model files default to assets/kokoro/. Override paths if stored elsewhere:
# KOKORO_MODEL_PATH=...\assets\kokoro\kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=...\assets\kokoro\voices-v1.0.bin

# --- Subtitles (local Whisper, free and optional) ---
# Off by default. Enabling it inserts a free step between merge and render that
# transcribes the narration and writes an SRT. The first run downloads the model
# weights (~150MB for "base"). BURN_SUBTITLES also draws them into the video, which
# costs one extra re-encode of the silent video.
SUBTITLES_ENABLED=False
BURN_SUBTITLES=False
# tiny | base | small | medium | large-v3 — bigger is slower and more accurate.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
SUBTITLE_LINE_WIDTH=42
SUBTITLE_FONT_SIZE=24

# --- Render (ffmpeg) ---
# "ffmpeg"/"ffprobe" if on PATH, else absolute paths.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# --- Currency + cost guardrail ---
# Providers bill in USD; costs are stored in USD and displayed in PKR.
USD_TO_PKR=280
MAX_COST_PER_VIDEO_PKR=7000

# --- Long-form generation tuning ---
WORDS_PER_MINUTE=150
DEFAULT_TARGET_MINUTES=90
TARGET_MINUTES_PER_PART=6
IMAGES_PER_PART=4
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

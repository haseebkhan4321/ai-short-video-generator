# Copy to .env and fill in. .env is gitignored.

# --- Django ---
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Sessions / auth ---
# Every page requires a login, so a session cookie is worth protecting.
# Two weeks by default; set SESSION_EXPIRE_AT_BROWSER_CLOSE=True to end on close.
SESSION_COOKIE_AGE=1209600
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
# Set both to True when serving over HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- MySQL (Laragon defaults) ---
DB_NAME=ai_shorts
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Provider API keys (leave blank until you add billing) ---
OPENAI_API_KEY=

# --- Models ---
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Text-to-speech (narration): Kokoro, local and free ---
TTS_PROVIDER=kokoro
DEFAULT_KOKORO_VOICE=af_heart
# Model files default to assets/kokoro/. Override paths if stored elsewhere:
# KOKORO_MODEL_PATH=...\assets\kokoro\kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=...\assets\kokoro\voices-v1.0.bin

# --- Render (ffmpeg) ---
# "ffmpeg"/"ffprobe" if on PATH, else absolute paths.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# --- Currency + cost guardrail ---
# Providers bill in USD; costs are stored in USD and displayed in PKR.
USD_TO_PKR=280
MAX_COST_PER_VIDEO_PKR=7000

# --- Long-form generation tuning ---
WORDS_PER_MINUTE=150
DEFAULT_TARGET_MINUTES=90
TARGET_MINUTES_PER_PART=6
IMAGES_PER_PART=4
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
